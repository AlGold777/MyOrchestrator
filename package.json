{
  "name": "llm-selector-manager",
  "version": "2.81.233",
  "private": true,
  "description": "Selector management and content scripts for multi-LLM browser extension",
  "scripts": {
    "test": "jest --config tests/jest.config.js",
    "test:telemetry": "node tests/telemetry-devtools-check.js",
    "validate:telemetry": "node scripts/validate-proof-telemetry.js",
    "measure:telemetry": "node scripts/analyze-proof-telemetry-size.js",
    "test:telemetry-parity": "jest --config tests/jest.config.js --runInBand tests/proof-telemetry-semantic-comparator.test.js",
    "build:telemetry-report": "node scripts/build-proof-telemetry-report.js",
    "test:qwen": "node tests/qwen-playwright-check.js",
    "test:answer-matrix": "node scripts/answer-completeness-matrix.js",
    "fixtures:import-b1": "node scripts/import-b1-skeletons.js",
    "auth:models": "node scripts/manual-auth-real-pages.js",
    "build:bundles": "node scripts/build-bundles.js",
    "build:content-bundle": "node scripts/build-content-bundle.js",
    "scroll:stress": "node tests/scroll-coordinator.stress.js",
    "selectors:keygen": "node scripts/sign-selectors.js keygen",
    "selectors:sign": "node scripts/sign-selectors.js sign"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.57.0",
    "stylelint": "^16.26.0"
  },
  "dependencies": {
    "cheerio": "^1.1.2"
  }
}
