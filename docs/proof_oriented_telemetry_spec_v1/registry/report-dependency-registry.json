{
  "registryVersion": "3.0.0",
  "predicateLanguageVersion": "1.0.0",
  "maxEscalationDepth": 2,
  "rules": {
    "cutted": [
      {
        "reportType": "false-success",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.postTerminalGrowthPct",
              "operator": "gt",
              "value": 0.5
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "cutted",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "old-answer",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.answerIdentity",
              "operator": "ne",
              "value": "current_dispatch"
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "cutted",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "empty",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.acceptedTextLength",
              "operator": "eq",
              "value": 0
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "cutted",
          "requestTargetOnlyOnce": true
        }
      }
    ],
    "false-success": [
      {
        "reportType": "cutted",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.extractionCoveragePct",
              "operator": "lt",
              "value": 98
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "false-success",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "late-end",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.stableToTerminalMs",
              "operator": "gt",
              "value": 0
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "false-success",
          "requestTargetOnlyOnce": true
        }
      }
    ],
    "old-answer": [
      {
        "reportType": "empty",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.acceptedTextLength",
              "operator": "eq",
              "value": 0
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "old-answer",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "cutted",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.extractionCoveragePct",
              "operator": "lt",
              "value": 98
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "old-answer",
          "requestTargetOnlyOnce": true
        }
      }
    ],
    "empty": [
      {
        "reportType": "old-answer",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.answerIdentity",
              "operator": "ne",
              "value": "current_dispatch"
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "empty",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "cutted",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.maxObservedTextLength",
              "operator": "gt",
              "value": 0
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "empty",
          "requestTargetOnlyOnce": true
        }
      }
    ],
    "prompt-not-sent": [],
    "late-end": [
      {
        "reportType": "false-success",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.postTerminalGrowthPct",
              "operator": "gt",
              "value": 0.5
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "late-end",
          "requestTargetOnlyOnce": true
        }
      }
    ]
  }
}
