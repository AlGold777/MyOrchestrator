{
  "registryVersion": "4.0.0",
  "predicateLanguageVersion": "1.0.0",
  "maxEscalationDepth": 2,
  "applicability": {
    "cutted": {
      "all": [
        {
          "path": "$.derivedViews.terminalOutcome",
          "operator": "eq",
          "value": "SUCCESS"
        },
        {
          "path": "$.derivedViews.incompleteCaptureEvidence",
          "operator": "eq",
          "value": true
        }
      ]
    },
    "false-success": {
      "all": [
        {
          "path": "$.derivedViews.terminalOutcome",
          "operator": "eq",
          "value": "SUCCESS"
        },
        {
          "path": "$.derivedViews.postTerminalAuditStatus",
          "operator": "eq",
          "value": "completed"
        },
        {
          "path": "$.derivedViews.postTerminalGrowthProven",
          "operator": "eq",
          "value": true
        }
      ]
    },
    "old-answer": {
      "all": [
        {
          "path": "$.derivedViews.oldAnswerEvidence",
          "operator": "eq",
          "value": true
        }
      ]
    },
    "empty": {
      "all": [
        {
          "path": "$.derivedViews.generationTextObserved",
          "operator": "eq",
          "value": true
        },
        {
          "path": "$.derivedViews.emptyExtractionEvidence",
          "operator": "eq",
          "value": true
        }
      ]
    },
    "prompt-not-sent": {
      "all": [
        {
          "path": "$.derivedViews.promptNotSentEvidence",
          "operator": "eq",
          "value": true
        }
      ]
    },
    "late-end": {
      "all": [
        {
          "path": "$.derivedViews.stableToTerminalComparable",
          "operator": "eq",
          "value": true
        },
        {
          "path": "$.derivedViews.stableToTerminalMs",
          "operator": "gt",
          "value": 0
        }
      ]
    }
  },
  "rules": {
    "cutted": [
      {
        "reportType": "false-success",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.postTerminalGrowthProven",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "cutted",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "old-answer",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.oldAnswerEvidence",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "cutted",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "empty",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.emptyExtractionEvidence",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "cutted",
          "requestTargetOnlyOnce": true
        }
      }
    ],
    "false-success": [
      {
        "reportType": "cutted",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.incompleteCaptureEvidence",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "false-success",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "late-end",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.stableToTerminalMs",
              "operator": "gt",
              "value": 0
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "false-success",
          "requestTargetOnlyOnce": true
        }
      }
    ],
    "old-answer": [
      {
        "reportType": "empty",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.emptyExtractionEvidence",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "old-answer",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "cutted",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.incompleteCaptureEvidence",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "old-answer",
          "requestTargetOnlyOnce": true
        }
      }
    ],
    "empty": [
      {
        "reportType": "old-answer",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.oldAnswerEvidence",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "empty",
          "requestTargetOnlyOnce": true
        }
      },
      {
        "reportType": "cutted",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.incompleteCaptureEvidence",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "empty",
          "requestTargetOnlyOnce": true
        }
      }
    ],
    "prompt-not-sent": [],
    "late-end": [
      {
        "reportType": "false-success",
        "relation": "diagnostic-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.postTerminalGrowthProven",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "antiLoop": {
          "sourceReportType": "late-end",
          "requestTargetOnlyOnce": true
        }
      }
    ]
  }
}
