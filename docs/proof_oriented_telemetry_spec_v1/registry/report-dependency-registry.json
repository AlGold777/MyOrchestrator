{
  "registryVersion": "1.0.0",
  "predicateLanguageVersion": "1.0",
  "thresholds": {
    "generationStartTimeoutMs": 15000,
    "stableWindowMs": 4500,
    "requiredStableSamples": 5,
    "maximumSignalAgeMs": 3000,
    "maximumObservationGapMs": 5000,
    "postTerminalAuditMs": 7000,
    "minimumExtractionCoveragePct": 98.0,
    "postTerminalGrowthTolerancePct": 0.5,
    "automaticMinimumEvidenceTier": 3,
    "maximumSignalSkewMs": 250
  },
  "operators": [
    "eq",
    "ne",
    "in",
    "not_in",
    "lt",
    "lte",
    "gt",
    "gte",
    "exists",
    "missing"
  ],
  "rules": {
    "request-not-sent": [
      {
        "reportType": "submission-proof",
        "relation": "same-evidence-chain",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.submission",
              "operator": "in",
              "value": [
                "evidence_partial",
                "unknown"
              ]
            },
            {
              "path": "$.reportDescriptor.completeness.evidenceCoveragePct",
              "operator": "lt",
              "value": 80
            }
          ]
        },
        "requestPurpose": "Отделить неудачу action dispatch от отсутствия platform acceptance."
      },
      {
        "reportType": "generation-not-started",
        "relation": "next-stage",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.derivedViews.userMessageAppeared",
              "operator": "eq",
              "value": true
            },
            {
              "path": "$.derivedViews.firstGenerationSignalDelayMs",
              "operator": "gte",
              "value": 15000
            }
          ]
        },
        "requestPurpose": "Проверить, был ли запрос принят, но генерация не стартовала."
      }
    ],
    "generation-not-started": [
      {
        "reportType": "submission-proof",
        "relation": "prerequisite",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.submission",
              "operator": "ne",
              "value": "confirmed"
            },
            {
              "path": "$.derivedViews.submissionEvidenceTier",
              "operator": "lt",
              "value": 3
            }
          ]
        },
        "requestPurpose": "Подтвердить, что ожидание генерации началось после принятого запроса."
      },
      {
        "reportType": "request-not-sent",
        "relation": "alternative-cause",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.derivedViews.firstGenerationSignalDelayMs",
              "operator": "gte",
              "value": 15000
            },
            {
              "path": "$.derivedViews.assistantCandidateCount",
              "operator": "eq",
              "value": 0
            },
            {
              "path": "$.stateAxes.submission",
              "operator": "in",
              "value": [
                "failed",
                "evidence_partial",
                "unknown"
              ]
            }
          ]
        },
        "requestPurpose": "Проверить альтернативу: запрос не был принят платформой."
      }
    ],
    "truncation": [
      {
        "reportType": "true-completion",
        "relation": "cause",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.completionEvidenceTier",
              "operator": "lt",
              "value": 3
            },
            {
              "path": "$.stateAxes.terminalMode",
              "operator": "in",
              "value": [
                "forced",
                "recovery",
                "manual"
              ]
            }
          ]
        },
        "requestPurpose": "Отличить реальное окончание модели от преждевременной финализации."
      },
      {
        "reportType": "extraction-integrity",
        "relation": "alternative-cause",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.extractionCoveragePct",
              "operator": "lt",
              "value": 98.0
            },
            {
              "path": "$.derivedViews.relevantCandidateCount",
              "operator": "gt",
              "value": 1
            },
            {
              "path": "$.derivedViews.hiddenRelevantNodeCount",
              "operator": "gt",
              "value": 0
            }
          ]
        },
        "requestPurpose": "Проверить, осталась ли часть текста в другом или невидимом DOM-кандидате."
      },
      {
        "reportType": "forced-finalization",
        "relation": "mechanism",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.terminalMode",
              "operator": "eq",
              "value": "forced"
            },
            {
              "path": "$.derivedViews.deadlineExceeded",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "requestPurpose": "Установить, остановило ли расширение ожидание по таймауту."
      },
      {
        "reportType": "forced-success",
        "relation": "status-projection",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.derivedViews.terminalOutcome",
              "operator": "eq",
              "value": "SUCCESS"
            },
            {
              "path": "$.derivedViews.automaticEvidenceSatisfied",
              "operator": "eq",
              "value": false
            }
          ]
        },
        "requestPurpose": "Объяснить, почему неполный ответ был спроецирован как SUCCESS."
      }
    ],
    "true-completion": [
      {
        "reportType": "truncation",
        "relation": "audit-result",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.postTerminalGrowthPct",
              "operator": "gt",
              "value": 0.5
            },
            {
              "path": "$.derivedViews.postTerminalHashChanged",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "requestPurpose": "Классифицировать продолжение ответа после terminal decision как возможную обрезку."
      },
      {
        "reportType": "extraction-integrity",
        "relation": "identity-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.answerIdentity",
              "operator": "in",
              "value": [
                "ambiguous",
                "stale",
                "rejected"
              ]
            },
            {
              "path": "$.derivedViews.extractionCoveragePct",
              "operator": "lt",
              "value": 98.0
            }
          ]
        },
        "requestPurpose": "Проверить, что completion оценивался по правильному и полному кандидату."
      },
      {
        "reportType": "forced-finalization",
        "relation": "alternative-terminal",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.stateAxes.completionDetection",
              "operator": "in",
              "value": [
                "inconclusive",
                "probably_complete"
              ]
            },
            {
              "path": "$.stateAxes.terminalMode",
              "operator": "eq",
              "value": "forced"
            }
          ]
        },
        "requestPurpose": "Разделить detected completion и прекращение ожидания по policy."
      },
      {
        "reportType": "forced-success",
        "relation": "projection-audit",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.derivedViews.terminalOutcome",
              "operator": "eq",
              "value": "SUCCESS"
            },
            {
              "path": "$.derivedViews.completionEvidenceTier",
              "operator": "lt",
              "value": 3
            }
          ]
        },
        "requestPurpose": "Проверить SUCCESS при недостаточном evidence tier."
      }
    ],
    "submission-proof": [
      {
        "reportType": "request-not-sent",
        "relation": "negative-outcome",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.submission",
              "operator": "eq",
              "value": "failed"
            },
            {
              "path": "$.derivedViews.confirmedAcceptanceEvidenceCount",
              "operator": "eq",
              "value": 0
            }
          ]
        },
        "requestPurpose": "Диагностировать отрицательный исход той же dispatch evidence chain."
      },
      {
        "reportType": "generation-not-started",
        "relation": "next-stage",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.stateAxes.submission",
              "operator": "eq",
              "value": "confirmed"
            },
            {
              "path": "$.derivedViews.firstGenerationSignalDelayMs",
              "operator": "gte",
              "value": 15000
            }
          ]
        },
        "requestPurpose": "Проверить, почему после подтверждённой отправки не началась генерация."
      }
    ],
    "extraction-integrity": [
      {
        "reportType": "truncation",
        "relation": "symptom",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.extractionCoveragePct",
              "operator": "lt",
              "value": 98.0
            },
            {
              "path": "$.derivedViews.hiddenRelevantTextLength",
              "operator": "gt",
              "value": 0
            }
          ]
        },
        "requestPurpose": "Оценить влияние неполного извлечения на итоговый ответ."
      },
      {
        "reportType": "true-completion",
        "relation": "temporal-dependency",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.captureBeforeTerminal",
              "operator": "eq",
              "value": true
            },
            {
              "path": "$.derivedViews.completionEvidenceTier",
              "operator": "lt",
              "value": 3
            }
          ]
        },
        "requestPurpose": "Проверить, не извлекался ли текст до истинного окончания генерации."
      },
      {
        "reportType": "forced-finalization",
        "relation": "temporal-cause",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.terminalMode",
              "operator": "eq",
              "value": "forced"
            },
            {
              "path": "$.derivedViews.terminalBeforeLastRelevantMutation",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "requestPurpose": "Проверить, прекратило ли расширение ожидание до завершения DOM-эволюции."
      }
    ],
    "forced-success": [
      {
        "reportType": "true-completion",
        "relation": "evidence-gap",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.derivedViews.terminalOutcome",
              "operator": "eq",
              "value": "SUCCESS"
            },
            {
              "path": "$.derivedViews.completionEvidenceTier",
              "operator": "lt",
              "value": 3
            }
          ]
        },
        "requestPurpose": "Установить, завершилась ли модель фактически."
      },
      {
        "reportType": "forced-finalization",
        "relation": "mechanism",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.terminalMode",
              "operator": "eq",
              "value": "forced"
            },
            {
              "path": "$.derivedViews.timeoutTriggerObserved",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "requestPurpose": "Проверить конкретный механизм принудительной финализации."
      },
      {
        "reportType": "extraction-integrity",
        "relation": "accepted-answer-quality",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.stateAxes.extraction",
              "operator": "in",
              "value": [
                "fallback",
                "ambiguous"
              ]
            },
            {
              "path": "$.derivedViews.extractionCoveragePct",
              "operator": "lt",
              "value": 98.0
            }
          ]
        },
        "requestPurpose": "Проверить качество текста, принятого forced-веткой."
      },
      {
        "reportType": "truncation",
        "relation": "consequence",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.postTerminalGrowthPct",
              "operator": "gt",
              "value": 0.5
            },
            {
              "path": "$.derivedViews.extractionCoveragePct",
              "operator": "lt",
              "value": 98.0
            }
          ]
        },
        "requestPurpose": "Проверить, привёл ли forced SUCCESS к обрезанному ответу."
      }
    ],
    "forced-finalization": [
      {
        "reportType": "forced-success",
        "relation": "status-projection",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.terminalOutcome",
              "operator": "eq",
              "value": "SUCCESS"
            }
          ]
        },
        "requestPurpose": "Проверить, был ли forced terminal спроецирован как SUCCESS."
      },
      {
        "reportType": "true-completion",
        "relation": "counterfactual",
        "priority": "required",
        "requestIf": {
          "any": [
            {
              "path": "$.derivedViews.completionEvidenceTier",
              "operator": "lt",
              "value": 3
            },
            {
              "path": "$.derivedViews.activeSignalAtForce",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "requestPurpose": "Установить, завершилась ли модель до принудительного прекращения ожидания."
      },
      {
        "reportType": "generation-not-started",
        "relation": "pre-start-timeout",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.stateAxes.observedGeneration",
              "operator": "eq",
              "value": "not_started"
            },
            {
              "path": "$.derivedViews.answerLengthAtForce",
              "operator": "eq",
              "value": 0
            }
          ]
        },
        "requestPurpose": "Отличить timeout ожидания старта от timeout активной генерации."
      },
      {
        "reportType": "truncation",
        "relation": "post-force-consequence",
        "priority": "required",
        "requestIf": {
          "all": [
            {
              "path": "$.derivedViews.answerLengthAtForce",
              "operator": "gt",
              "value": 0
            },
            {
              "path": "$.derivedViews.postTerminalGrowthPct",
              "operator": "gt",
              "value": 0.5
            }
          ]
        },
        "requestPurpose": "Проверить, была ли сохранена неполная версия ответа."
      }
    ]
  },
  "antiLoopPolicy": {
    "maxEscalationDepth": 2,
    "doNotRequestAlreadyProvided": true,
    "doNotRequestAlreadyRequested": true,
    "requireNewQuestionToResolve": true
  },
  "registryHash": "sha256:ee727e80bbeb45cfc7b8c736f532219ffc65696d7cc4143707775b8ed46babbd"
}