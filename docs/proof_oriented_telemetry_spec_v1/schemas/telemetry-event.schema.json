{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/telemetry-event.schema.json",
  "title": "Canonical telemetry event",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "layer",
    "seq",
    "wallTs",
    "monoMs",
    "runSessionId",
    "producer",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 5
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "layer": {
      "enum": [
        "fact",
        "inference",
        "decision",
        "action",
        "audit",
        "system"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "wallTs": {
      "type": "integer",
      "minimum": 0
    },
    "monoMs": {
      "type": "number",
      "minimum": 0
    },
    "runSessionId": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "dispatchId": {
      "type": "string"
    },
    "generationEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "tabId": {
      "type": "integer"
    },
    "documentInstanceId": {
      "type": "string"
    },
    "navigationEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "conversationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "turnId": {
      "type": "string"
    },
    "candidateId": {
      "type": "string"
    },
    "captureId": {
      "type": "string"
    },
    "causationId": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "producer": {
      "type": "object",
      "required": [
        "component",
        "version"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}