{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/canonical-evidence.schema.json",
  "title": "Canonical proof telemetry evidence",
  "type": "object",
  "required": [
    "schemaVersion", "containerType", "exportId", "createdAt", "exportMode",
    "run", "sharedConfig", "dependencyRegistry", "ledger", "incidentIndex",
    "readerGuidance", "attachments", "omissions", "sourceSnapshot",
    "diagnosticUsability", "privacy", "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "containerType": { "const": "canonical-evidence" },
    "exportId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "exportMode": { "const": "canonical-evidence" },
    "run": { "type": "object" },
    "sharedConfig": {
      "type": "object",
      "required": ["runtimeRunConfig", "extensionVersion", "generatorVersion", "reportVersion", "policyIdentity", "sourceCompatibility"]
    },
    "dependencyRegistry": { "type": "object" },
    "ledger": {
      "type": "object",
      "required": ["encoding", "firstSeq", "lastSeq", "eventCount", "ledgerHash", "events"],
      "properties": {
        "encoding": { "const": "inline-json" },
        "firstSeq": { "type": "integer", "minimum": 0 },
        "lastSeq": { "type": "integer", "minimum": 0 },
        "eventCount": { "type": "integer", "minimum": 0 },
        "ledgerHash": { "type": "string" },
        "events": { "type": "array", "items": { "type": "object" } }
      }
    },
    "incidentIndex": {
      "type": "object",
      "required": ["version", "incidentCount", "incidents"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "incidentCount": { "type": "integer", "minimum": 0 },
        "incidents": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/incidentIndexItem" }
        }
      }
    },
    "readerGuidance": {
      "type": "object",
      "required": ["kind", "version", "trustedSource", "instructions", "hash"],
      "properties": {
        "kind": { "const": "guidance" },
        "version": { "type": "string" },
        "trustedSource": { "const": "versioned-code-constant" },
        "instructions": { "type": "array", "items": { "type": "string" } },
        "hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "attachments": { "type": "object" },
    "omissions": { "type": "array" },
    "sourceSnapshot": { "type": "object" },
    "diagnosticUsability": { "type": "object" },
    "privacy": { "type": "object" },
    "integrity": {
      "type": "object",
      "required": ["hashes", "size", "schemaValidation"]
    }
  },
  "$defs": {
    "axisProvenance": {
      "type": "object",
      "required": ["layer", "basisEventIds", "ruleId", "derivationVersion"],
      "properties": {
        "layer": { "enum": ["fact", "inference", "decision", "audit"] },
        "basisEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "ruleId": { "type": "string", "minLength": 1 },
        "derivationVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "incidentIndexItem": {
      "type": "object",
      "required": ["incidentId", "scope", "firstSeq", "lastSeq", "eventCount", "stateAxes", "stateAxesProvenance"],
      "properties": {
        "incidentId": { "type": "string" },
        "scope": { "type": "object" },
        "firstSeq": { "type": "integer" },
        "lastSeq": { "type": "integer" },
        "eventCount": { "type": "integer" },
        "stateAxes": { "type": "object" },
        "stateAxesProvenance": {
          "type": "object",
          "required": [
            "submission", "generationStart", "answerIdentity", "observedGeneration",
            "textEvolution", "answerCompleteness", "extraction", "verification",
            "completionDetection", "completionEvidenceTier", "observationReliability",
            "finalization", "terminalMode", "terminationCause"
          ],
          "additionalProperties": { "$ref": "#/$defs/axisProvenance" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
