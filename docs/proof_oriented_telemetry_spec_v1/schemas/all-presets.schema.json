{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/all-presets.schema.json",
  "title": "All-presets export container",
  "type": "object",
  "required": [
    "schemaVersion",
    "containerType",
    "exportId",
    "manifest",
    "crossReportCompatibility",
    "sharedConfig",
    "ledger",
    "derivedViews",
    "reports",
    "diagnosisArbitration",
    "migration",
    "attachments",
    "exportAudit"
  ],
  "properties": {
    "schemaVersion": {
      "const": "5.0"
    },
    "containerType": {
      "const": "all-presets"
    },
    "exportId": {
      "type": "string"
    },
    "manifest": {
      "type": "object"
    },
    "crossReportCompatibility": {
      "type": "object"
    },
    "sharedConfig": {
      "type": "object"
    },
    "ledger": {
      "type": "object"
    },
    "derivedViews": {
      "type": "object"
    },
    "reports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["reportDescriptor", "eventSeqs", "eventSelection"],
        "properties": {
          "reportDescriptor": {
            "type": "object",
            "required": ["applicability", "diagnosticVerdict", "completeness"],
            "properties": {
              "applicability": { "type": "object" },
              "diagnosticVerdict": {
                "enum": ["confirmed", "supported_but_incomplete", "not_confirmed", "unknown"]
              },
              "completeness": {
                "type": "object",
                "required": ["byIncident", "summarizedIncidentIds"],
                "properties": {
                  "byIncident": { "type": "object" },
                  "summarizedIncidentIds": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          },
          "eventSeqs": { "type": "array", "items": { "type": "number" } },
          "eventSelection": {
            "type": "object",
            "required": ["bySeq"],
            "properties": {
              "bySeq": {
                "type": "object",
                "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "diagnosisArbitration": {
      "type": "object"
    },
    "migration": {
      "type": "object",
      "required": ["phase", "shadowComparison", "canonicalLedgerShared"],
      "properties": {
        "phase": { "const": "empty-no-delivery-shadow" },
        "shadowComparison": { "type": "object" },
        "canonicalLedgerShared": { "const": true }
      },
      "additionalProperties": false
    },
    "attachments": {
      "type": "object"
    },
    "exportAudit": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
