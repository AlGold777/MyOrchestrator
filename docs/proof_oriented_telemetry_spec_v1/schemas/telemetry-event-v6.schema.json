{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/telemetry-event-v6.schema.json",
  "title": "Canonical proof telemetry event schema 6",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "layer",
    "seq",
    "ingestSeq",
    "runGeneration",
    "wallTs",
    "runSessionId",
    "producer",
    "clock",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 6 },
    "eventId": { "type": "string", "minLength": 16 },
    "eventType": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "layer": { "enum": ["fact", "inference", "decision", "action", "audit", "system"] },
    "seq": { "type": "integer", "minimum": 1 },
    "ingestSeq": { "type": "integer", "minimum": 1 },
    "runGeneration": { "type": "integer", "minimum": 1 },
    "wallTs": { "type": "integer", "minimum": 0 },
    "runSessionId": { "type": "string", "minLength": 1 },
    "modelId": { "type": "string" },
    "dispatchId": { "type": "string" },
    "generationEpoch": { "type": "integer", "minimum": 0 },
    "tabId": { "type": "integer" },
    "documentInstanceId": { "type": "string" },
    "navigationEpoch": { "type": "integer", "minimum": 0 },
    "conversationId": { "type": ["string", "null"] },
    "turnId": { "type": "string" },
    "candidateId": { "type": "string" },
    "captureId": { "type": "string" },
    "causationId": { "type": "string" },
    "correlationId": { "type": "string" },
    "producer": {
      "type": "object",
      "required": ["component", "version"],
      "properties": {
        "component": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "required": ["contractVersion", "producerEpochId", "originKind", "ingestEpochId", "ingestMonoMs"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "producerEpochId": { "type": "string" },
        "producerSequence": { "type": ["integer", "null"], "minimum": 0 },
        "observedAtLocalMonoMs": { "type": ["number", "null"], "minimum": 0 },
        "sentAtLocalMonoMs": { "type": ["number", "null"], "minimum": 0 },
        "originKind": { "enum": ["document", "worker", "system", "unknown"] },
        "ingestEpochId": { "type": "string" },
        "ingestMonoMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": ["typed"],
      "properties": {
        "typed": {
          "type": "object",
          "required": ["kind", "state"],
          "properties": {
            "kind": { "type": "string" },
            "state": { "type": ["string", "number", "boolean", "null"] }
          },
          "additionalProperties": true
        },
        "metadata": { "type": "object" },
        "sourceEventType": { "type": "string" },
        "sourceLevel": { "type": "string" }
      },
      "additionalProperties": true
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
