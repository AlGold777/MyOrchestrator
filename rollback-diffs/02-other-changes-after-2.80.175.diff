@@ -0,0 +1,36 @@
+const RecoveryIntent = require('../shared/recovery-intent');
+
+describe('shared recovery policy', () => {
+  let RecoveryPolicy;
+
+  beforeEach(() => {
+    jest.resetModules();
+    global.RecoveryIntent = RecoveryIntent;
+    global.DispatchRetry = {
+      getDispatchRetryDecision: jest.fn(() => ({ shouldRetry: true, delayMs: 1500, classification: 'TRANSIENT' }))
+    };
+    RecoveryPolicy = require('../shared/recovery-policy');
+  });
+
+  test('observes instead of resending after terminal-eligible answer evidence', () => {
+    const decision = RecoveryPolicy.decide({ answer: 'x'.repeat(200) }, {
+      intent: 'resend_prompt', attempt: 1, maxAttempts: 4, minChars: 80
+    });
+    expect(decision.action).toBe('OBSERVE');
+    expect(decision.reason).toBe('no_resend_after_answer_evidence');
+  });
+
+  test('requests reload for repeated transport failures', () => {
+    const decision = RecoveryPolicy.decide({}, {
+      intent: 'resend_prompt', attempt: 2, maxAttempts: 4, error: { type: 'ack_timeout' }
+    });
+    expect(decision.action).toBe('RELOAD');
+  });
+
+  test('finalizes error when the retry budget is exhausted', () => {
+    const decision = RecoveryPolicy.decide({}, {
+      intent: 'resend_prompt', attempt: 4, maxAttempts: 4, error: { type: 'connection_failed' }
+    });
+    expect(decision.action).toBe('FINALIZE_ERROR');
+  });
+});

