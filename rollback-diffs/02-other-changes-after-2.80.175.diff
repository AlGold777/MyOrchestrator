+    const policy = require('../shared/timeout-policy');
+
+    Object.values(policy.ROLES).forEach((role) => {
+      expect(policy.resolve(role)).toBeGreaterThan(0);
+    });
+  });
+
+  test('lets the model policy own submit timeout tuning', () => {
+    global.ModelPolicy = {
+      getPromptSubmitTimeoutMs: jest.fn(() => 23456)
+    };
+    const policy = require('../shared/timeout-policy');
+
+    expect(policy.resolve(policy.ROLES.SUBMIT, { model: 'Claude' })).toBe(23456);
+    expect(global.ModelPolicy.getPromptSubmitTimeoutMs).toHaveBeenCalledWith('Claude', 15000);
+  });
+
+  test('keeps long generation timeout separate from submit and recovery', () => {
+    const policy = require('../shared/timeout-policy');
+
+    expect(policy.resolve(policy.ROLES.GENERATION, { long: true })).toBe(480000);
+    expect(policy.resolve(policy.ROLES.RECOVERY)).toBe(12000);
+  });
+});

