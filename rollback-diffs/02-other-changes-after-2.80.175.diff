## shared/timeout-policy.js
User-facing description: Новая централизованная классификация timeout budgets и ролей.

--- /dev/null
+++ b/shared/timeout-policy.js
@@ -0,0 +1,33 @@
+// Named timeout roles shared by background and content runtimes.
+(function initTimeoutPolicy(root) {
+  'use strict';
+  const ROLES = Object.freeze({
+    HANDSHAKE: 'handshake',
+    SUBMIT: 'submit',
+    GENERATION: 'generation',
+    RECOVERY: 'recovery',
+    NO_FOCUS_PROBE: 'no_focus_probe',
+    TAB_READY: 'tab_ready'
+  });
+  const DEFAULTS = Object.freeze({
+    [ROLES.HANDSHAKE]: 6000,
+    [ROLES.SUBMIT]: 15000,
+    [ROLES.GENERATION]: 210000,
+    [ROLES.RECOVERY]: 12000,
+    [ROLES.NO_FOCUS_PROBE]: 5000,
+    [ROLES.TAB_READY]: 15000
+  });
+  function resolve(role, options = {}) {
+    const fallback = Number(options.fallback || DEFAULTS[role] || 0);
+    if (role === ROLES.SUBMIT && options.model && root.ModelPolicy?.getPromptSubmitTimeoutMs) {
+      return root.ModelPolicy.getPromptSubmitTimeoutMs(options.model, fallback);
+    }
+    if (role === ROLES.GENERATION && options.long === true) {
+      return Number(options.longFallback || 480000);
+    }
+    return fallback;
+  }
+  const api = Object.freeze({ ROLES, DEFAULTS, resolve });
+  root.TimeoutPolicy = api;
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+})(typeof globalThis !== 'undefined' ? globalThis : this);

