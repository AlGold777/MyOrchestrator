+  vm.runInContext(ORCHESTRATOR_SOURCE, context, { filename: 'background/job-orchestrator.js' });
+  return context;
+}
+
+describe('MV3 recovery behavior', () => {
+  beforeEach(() => {
+    jest.useFakeTimers();
+  });
+
+  afterEach(() => {
+    jest.useRealTimers();
+  });
+
+  test('rehydration resumes open submitted models and leaves terminal models closed', async () => {
+    const context = createRecoverySandbox();
+    context.jobState.llms.GPT.promptSubmittedAt = Date.now() - 100;
+    context.armScriptRuntimeHardStopForConfirmedPrompt = jest.fn();
+    context.schedulePromptDispatchSupervisor = jest.fn();
+
+    const recovered = context.rehydrateActiveJobRuntime('behavior_test');
+
+    expect(recovered).toBe(true);
+    expect(context.jobState.session.roundsInProgress).toBe(false);
+    expect(context.jobState.session.roundsRecoveredFromStuckAt).toBeTruthy();
+    expect(context.jobState.llms.GPT).toEqual(expect.objectContaining({
+      dispatchInFlight: false,
+      rehydratedAt: expect.any(Number)
+    }));
+    expect(context.jobState.llms.Claude.rehydratedAt).toBeUndefined();
+    expect(context.armScriptRuntimeHardStopForConfirmedPrompt).toHaveBeenCalledWith(
+      'GPT',
+      expect.objectContaining({ dispatchId: 'GPT:8801:1', tabId: 81 })
+    );
+
+    await jest.advanceTimersByTimeAsync(250);
+
+    expect(context.sendPassiveMessageWithRetries).toHaveBeenCalledWith(
+      81,
+      'GPT',
+      expect.objectContaining({
+        action: 'getResponses',
+        meta: expect.objectContaining({
+          source: 'mv3_rehydration_collect',
+          dispatchId: 'GPT:8801:1'
+        })
+      }),
+      expect.objectContaining({ allowRecovery: true })
+    );
+    expect(context.jobState.llms.GPT.adaptiveCollectActive).toBe(true);
+    expect(context.sendPassiveMessageWithRetries).not.toHaveBeenCalledWith(
+      82,
+      'Claude',
+      expect.anything(),
+      expect.anything()
+    );
+  });
+
+  test('persistence writes are serialized and stop removal wins over an in-flight save', async () => {
+    const context = createRecoverySandbox();
+    const order = [];
+    let releaseFirstWrite;
+    context.CompressedStorage.set
+      .mockImplementationOnce(() => new Promise((resolve) => {
+        order.push('set:first');
+        releaseFirstWrite = resolve;
+      }))
+      .mockImplementationOnce(() => {
+        order.push('set:second');
+        return Promise.resolve();
+      });
+    context.CompressedStorage.remove.mockImplementation(() => {
+      order.push('remove');
+      return Promise.resolve();
+    });
+
+    const first = context.saveJobState(context.jobState);
+    await Promise.resolve();
+    const second = context.saveJobState(context.jobState);
+    await Promise.resolve();
+    expect(order).toEqual(['set:first']);
+
+    releaseFirstWrite();
+    await Promise.all([first, second]);
+    expect(order).toEqual(['set:first', 'set:second']);
+
+    let releaseLateWrite;
+    context.CompressedStorage.set.mockImplementationOnce(() => new Promise((resolve) => {
+      order.push('set:late');
+      releaseLateWrite = resolve;
+    }));
+    const lateSave = context.saveJobState(context.jobState);
+    for (let i = 0; i < 5 && !releaseLateWrite; i += 1) await Promise.resolve();
+    expect(typeof releaseLateWrite).toBe('function');
+    const stop = context.invalidatePersistedJobState('user_cancel');
+    releaseLateWrite();
+    await Promise.all([lateSave, stop]);
+
+    expect(order.slice(-2)).toEqual(['set:late', 'remove']);
+    expect(context.chrome.storage.session.set).toHaveBeenCalledWith(expect.objectContaining({
+      llm_run_tombstone_v1: expect.objectContaining({ reason: 'user_cancel' })
+    }));
+  });
+});

