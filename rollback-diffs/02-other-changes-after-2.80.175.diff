## shared/completion-policy.js
User-facing description: Новая централизованная policy обязательных completion evidence и contradictions.

--- /dev/null
+++ b/shared/completion-policy.js
@@ -0,0 +1,36 @@
+// Shared, side-effect-free gate for completion observations.
+(function initCompletionPolicy(root) {
+  'use strict';
+
+  function evaluate(candidate = {}, options = {}) {
+    const confidence = Number(candidate.confidence || 0);
+    const minConfidence = Number(options.minConfidence || 0.8);
+    const text = String(candidate.text || '');
+    const classifier = root.AnswerContentClassifier || null;
+    const classification = classifier?.classify
+      ? classifier.classify(text, { minValid: Number(options.minValidChars || 20) })
+      : { terminalEligible: text.trim().length >= Number(options.minValidChars || 20), contentClass: 'length_fallback' };
+    const contradictions = [];
+    if (candidate.freshTurnEvidence !== true) contradictions.push('fresh_turn_missing');
+    if (candidate.textStable !== true) contradictions.push('text_unstable');
+    if (candidate.stopVisible === true) contradictions.push('stop_visible');
+    if (candidate.stopSignal === 'unknown') contradictions.push('stop_unknown');
+    if (candidate.loadingVisible === true) contradictions.push('loading_visible');
+    if (candidate.progressVisible === true) contradictions.push('progress_visible');
+    if (candidate.providerError === true) contradictions.push('provider_error');
+    if (!classification.terminalEligible) contradictions.push(`content_${classification.contentClass || 'ineligible'}`);
+    if (confidence < minConfidence) contradictions.push('confidence_low');
+    return {
+      accepted: contradictions.length === 0,
+      reason: contradictions[0] || 'completion_accepted',
+      contradictions,
+      confidence,
+      minConfidence,
+      classification
+    };
+  }
+
+  const api = Object.freeze({ evaluate });
+  root.CompletionPolicy = api;
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+})(typeof globalThis !== 'undefined' ? globalThis : this);

