+// One decision policy for automatic recovery actions. Executors remain in the
+// coordinator/orchestrator; this module only decides what is safe to do next.
+(function initRecoveryPolicy(root) {
+  'use strict';
+
+  const ACTIONS = Object.freeze({
+    WAIT: 'WAIT',
+    OBSERVE: 'OBSERVE',
+    RELOAD: 'RELOAD',
+    RESEND: 'RESEND',
+    FINALIZE_ERROR: 'FINALIZE_ERROR'
+  });
+
+  function decide(entry = {}, request = {}) {
+    const attempt = Number(request.attempt || 0);
+    const maxAttempts = Number(request.maxAttempts || 4);
+    const error = request.error || {};
+    const intent = request.intent || 'resend_prompt';
+    const intentDecision = root.RecoveryIntent?.authorize
+      ? root.RecoveryIntent.authorize(entry, {
+        intent,
+        reason: request.reason || error.type || error.code || 'recovery',
+        minChars: request.minChars || 80,
+        explicitUserOverride: request.explicitUserOverride === true,
+        allowAfterEvidence: request.allowAfterEvidence === true
+      })
+      : { ok: true, evidenceHit: false };
+    if (!intentDecision.ok) {
+      return { action: ACTIONS.OBSERVE, reason: intentDecision.reason, intentDecision, delayMs: 0 };
+    }
+    const retryDecision = root.DispatchRetry?.getDispatchRetryDecision
+      ? root.DispatchRetry.getDispatchRetryDecision(attempt, error)
+      : { shouldRetry: attempt < maxAttempts, delayMs: 2000, classification: 'UNKNOWN' };
+    if (attempt >= maxAttempts || retryDecision.shouldRetry === false) {
+      return { action: ACTIONS.FINALIZE_ERROR, reason: 'retry_exhausted', retryDecision, intentDecision, delayMs: 0 };
+    }
+    const errorType = String(error?.type || error?.code || error?.message || '').toLowerCase();
+    if (attempt >= 2 && /ack|connection|no_receiver|tab_not_ready|page_not_ready/.test(errorType)) {
+      return { action: ACTIONS.RELOAD, reason: 'transport_recovery', retryDecision, intentDecision, delayMs: retryDecision.delayMs || 0 };
+    }
+    if (retryDecision.classification === 'RATE_LIMITED') {
+      return { action: ACTIONS.WAIT, reason: 'rate_limited', retryDecision, intentDecision, delayMs: retryDecision.delayMs || 0 };
+    }
+    return { action: ACTIONS.RESEND, reason: 'retryable_failure', retryDecision, intentDecision, delayMs: retryDecision.delayMs || 0 };
+  }
+
+  const api = Object.freeze({ ACTIONS, decide });
+  root.RecoveryPolicy = api;
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+})(typeof globalThis !== 'undefined' ? globalThis : this);

