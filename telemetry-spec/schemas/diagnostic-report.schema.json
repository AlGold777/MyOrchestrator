{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/diagnostic-report.schema.json",
  "title": "Standalone diagnostic report",
  "type": "object",
  "required": [
    "schemaVersion",
    "fileKind",
    "reportDescriptor",
    "correlation",
    "diagnosticSummary",
    "stateAxes",
    "stateAxesProvenance",
    "eventSelection",
    "derivedViews",
    "siblings",
    "analysisInstructions",
    "crossReportCompatibility",
    "exportIntegrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "5.0"
    },
    "fileKind": {
      "const": "diagnostic-report"
    },
    "reportDescriptor": {
      "type": "object",
      "required": [
        "reportId",
        "reportType",
        "reportVersion",
        "title",
        "primaryQuestion",
        "applicability",
        "diagnosticVerdict",
        "canDiagnose",
        "cannotDiagnoseAlone",
        "completeness",
        "reportMode",
        "dependencyRegistryVersion",
        "dependencyRegistryHash"
      ],
      "properties": {
        "reportId": {
          "type": "string"
        },
        "reportType": {
          "type": "string"
        },
        "reportVersion": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "primaryQuestion": {
          "type": "string"
        },
        "applicability": {
          "type": "object",
          "required": [
            "status",
            "mode",
            "predicateResults",
            "refutationResults"
          ],
          "properties": {
            "status": {
              "enum": [
                "confirmed",
                "not_confirmed",
                "unknown"
              ]
            },
            "mode": {
              "const": "all"
            },
            "predicateResults": {
              "type": "array"
            },
            "refutationResults": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "diagnosticVerdict": {
          "enum": [
            "confirmed",
            "supported_but_incomplete",
            "not_confirmed",
            "unknown"
          ]
        },
        "canDiagnose": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "cannotDiagnoseAlone": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "completeness": {
          "type": "object"
        },
        "reportMode": {
          "enum": [
            "standalone",
            "embedded-in-all-presets"
          ]
        },
        "dependencyRegistryVersion": {
          "type": "string"
        },
        "dependencyRegistryHash": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "correlation": {
      "type": "object"
    },
    "reportCatalogSnapshot": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "runConfiguration": {
      "type": "object"
    },
    "diagnosticSummary": {
      "type": "object"
    },
    "stateAxes": {
      "type": "object"
    },
    "stateAxesProvenance": {
      "type": "object",
      "required": [
        "submission", "generationStart", "answerIdentity", "observedGeneration",
        "textEvolution", "answerCompleteness", "extraction", "verification",
        "completionDetection", "completionEvidenceTier", "observationReliability",
        "finalization", "terminalMode", "terminationCause"
      ],
      "additionalProperties": false,
      "properties": {
        "submission": { "$ref": "#/$defs/axisProvenance" },
        "generationStart": { "$ref": "#/$defs/axisProvenance" },
        "answerIdentity": { "$ref": "#/$defs/axisProvenance" },
        "observedGeneration": { "$ref": "#/$defs/axisProvenance" },
        "textEvolution": { "$ref": "#/$defs/axisProvenance" },
        "answerCompleteness": { "$ref": "#/$defs/axisProvenance" },
        "extraction": { "$ref": "#/$defs/axisProvenance" },
        "verification": { "$ref": "#/$defs/axisProvenance" },
        "completionDetection": { "$ref": "#/$defs/axisProvenance" },
        "completionEvidenceTier": { "$ref": "#/$defs/axisProvenance" },
        "observationReliability": { "$ref": "#/$defs/axisProvenance" },
        "finalization": { "$ref": "#/$defs/axisProvenance" },
        "terminalMode": { "$ref": "#/$defs/axisProvenance" },
        "terminationCause": { "$ref": "#/$defs/axisProvenance" }
      }
    },
    "eventSelection": {
      "type": "object"
    },
    "derivedViews": {
      "type": "object"
    },
    "contradictions": {
      "type": "array"
    },
    "missingEvidence": {
      "type": "array"
    },
    "siblings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "analysisInstructions": {
      "type": "object"
    },
    "crossReportCompatibility": {
      "type": "object"
    },
    "attachments": {
      "type": "array"
    },
    "exportIntegrity": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "axisProvenance": {
      "type": "object",
      "required": ["layer", "basisEventIds", "ruleId", "derivationVersion"],
      "properties": {
        "layer": { "enum": ["fact", "inference", "decision", "audit"] },
        "basisEventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "ruleId": { "type": "string", "minLength": 1 },
        "derivationVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
