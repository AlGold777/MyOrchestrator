    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "downloads",
    "downloads.ui",
    "debugger"
  ],
  "host_permissions": [
    "*://chat.openai.com/*",
